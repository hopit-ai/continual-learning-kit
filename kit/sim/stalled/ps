#!/usr/bin/env python3
"""A STALLING stand-in for `ps` (round-6 ruling J1; tests and scripts/simulate_p4.py's stalled-discovery phase).

While the file named by $SIM_STALL_FILE exists, the two whole-system scans of the job boundary block for
$SIM_STALL_SECONDS (default 600) before they answer: `ps eww ...` (the environment-marker scan) and `ps -A ...` (the
process-group scan). Per-process lookups (`ps -o ... -p PID`) are not delayed. One process; then the real `ps`.
"""
import os
import shutil
import sys
import time

args = sys.argv[1:]
stall = os.environ.get("SIM_STALL_FILE")
if stall and os.path.exists(stall) and args and (args[0] == "eww" or "-A" in args):
    time.sleep(float(os.environ.get("SIM_STALL_SECONDS", "600")))
here = os.path.dirname(os.path.abspath(__file__))
path = os.pathsep.join(p for p in os.environ.get("PATH", "").split(os.pathsep) if p and os.path.abspath(p) != here)
real = shutil.which("ps", path=path) or "/bin/ps"
os.execv(real, [real] + args)
